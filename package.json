{
  "name": "ecommerce-monorepo",
  "version": "1.0.0",
  "description": "E-commerce monorepo with backend and frontend",
  "private": true,
  "scripts": {
    "start": "docker compose up -d",
    "stop": "docker compose down",
    "restart": "docker compose restart",
    "logs": "docker compose logs -f",
    "logs:server": "docker compose logs -f server",
    "logs:postgres": "docker compose logs -f postgres",
    "logs:redis": "docker compose logs -f redis",
    "build": "docker compose build",
    "build:server": "docker compose build server",
    "dev:server": "cd server && npm run start:dev",
    "test:server": "cd server && npm test",
    "prisma:studio": "cd server && npx prisma studio",
    "prisma:migrate": "cd server && npx prisma migrate dev",
    "prisma:generate": "cd server && npx prisma generate"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/ecommerce.git"
  },
  "author": "",
  "license": "ISC"
}
